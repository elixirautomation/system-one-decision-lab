# The single .env for every package in this monorepo.
#
# Loaded by loadLabEnv() in @sysone/config, which resolves the repository root
# explicitly: Yarn runs a workspace script with the PACKAGE directory as cwd, so
# a plain dotenv would find no file and fall back to defaults in silence.
#
# The shell wins over this file, so `DECISION_PROVIDER=jev yarn lab e2e` works.
# The exception is BASE_URL / SITE_USERNAME / SITE_PASSWORD in section 4, which
# the Playwright use case forces from here via loadLabEnv({ overrideKeys }) so a
# stale shell export cannot point the suite at the wrong environment.
#
# Sections follow the architecture, outermost first: pick a decision model, give
# that model its provider parameters, then the shared platform, and finally the
# use cases that consume all of it. Nothing in section 4 reaches sections 1–3.

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  1 · DECISION MODEL                                                        ║
# ║  Which engine answers, and how sure it must be before acting.              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Provider definitions implement the same contract; each executable use case
# composes the definitions it supports and chooses its own default.
#   jev   Hosted TypeSafe Jev API. Requires JEV_API_KEY; sends evidence off-host.
#   laya  Laya (Apache-2.0) served locally by root Compose. No data egress.
#   kev   Kev (Apache-2.0) served locally by root Compose. No data egress.
DECISION_PROVIDER=jev

# ── Egress consent ────────────────────────────────────────────────────────────
# Consent for sending failure evidence to a REMOTE endpoint. It is derived from
# the resolved endpoint, not the provider name: a locally served engine never
# needs it, but pointing one at a hosted endpoint does.
ALLOW_DECISION_DATA_EGRESS=false

# ── Confidence gate overrides ─────────────────────────────────────────────────
# Unset means each provider's own documented defaults apply — see gateDefaults
# in its definition under packages/providers/<id>/src/index.ts. Overrides are
# shared across engines deliberately: you tune one active configuration.
# DECISION_CHOICE_GATE=confidence
# DECISION_ACT_THRESHOLD=0.60
# DECISION_REVIEW_THRESHOLD=0.35

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  2 · DECISION PROVIDERS                                                    ║
# ║  Parameters of the engines the model above can select.                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── jev · hosted TypeSafe API ─────────────────────────────────────────────────
# JEV_API_KEY is declared `required` by the adapter: the service has no
# anonymous access at any endpoint. Key from https://console.typesafe.ai/keys
JEV_API_KEY=
JEV_MODEL=jev-latest
# Origin the /v1/systemone path is appended to, then a full-URL override.
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_ENDPOINT=

# ── laya · self-hosted, Apache-2.0 ────────────────────────────────────────────
# Commands run natively via yarn, so this is the port Compose publishes.
LAYA_BASE_URL=http://localhost:8000
# Checkpoint: english, multilingual, or typed-decisions.
LAYA_MODEL=english
# Bearer token enforced by laya-serve. Empty is fine locally; it becomes
# mandatory as soon as the endpoint resolves to a remote host.
LAYA_API_KEY=
# LAYA_ENDPOINT=

# ── laya server runtime · read by root compose.yml ────────────────────────────
# These configure the container, not the adapter. Checkpoints kept resident by
# the server: English alone is enough for English-language Playwright failures
# and halves load time and memory.
LAYA_MODELS=english
LAYA_DEVICE=cpu
LAYA_THREADS=4
LAYA_HOST_PORT=8000
# LAYA_PRELOAD=1
# LAYA_AUTO_TASK=0
# LAYA_LOG_LEVEL=info
# LAYA_TORCH_INDEX=cpu
# HF_HUB_OFFLINE=0

# ── kev · self-hosted, Apache-2.0 ─────────────────────────────────────────────
# Commands run natively via yarn, so this is the port Compose publishes.
KEV_BASE_URL=http://localhost:8009
# Name sent in the request. The server answers kev-latest (and jev-latest) with
# whichever checkpoint KEV_RUN loaded, so this does not select weights.
KEV_MODEL=kev-latest
# Bearer token enforced by kev.serve when set. Empty is fine locally; it becomes
# mandatory as soon as the endpoint resolves to a remote host.
KEV_API_KEY=
# KEV_ENDPOINT=

# ── kev server runtime · read by root compose.yml ─────────────────────────────
# Hugging Face checkpoint to serve. 0.8B is the only size practical on CPU in a
# default 8 GB Docker Desktop VM (about 4 GB resident). kev-4b is more accurate
# and needs a 16 GB VM plus KEV_DTYPE=bf16 (about 11 GB resident).
KEV_RUN=jaredpalmer/kev-0.8b
KEV_THREADS=4
KEV_HOST_PORT=8009
# KEV_DTYPE=           # empty = fp32 on CPU; bf16 halves memory, slightly different probabilities
# KEV_DATE_FACTS=0
# KEV_TORCH_INDEX=cpu

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  3 · PLATFORM INFRASTRUCTURE                                               ║
# ║  Persistence and container lifecycle, shared by every use case.            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Exposed by the local Compose stack. Persistence receives DATABASE_URL
# explicitly from a composition root; it never reads this file itself.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://decisionlab:decisionlab@localhost:5433/decision_lab

# Two checkouts on one machine need their own project name and port, or the
# second shares the first one's database.
# COMPOSE_PROJECT_NAME=sysone-lab

# ── Container lifecycle timeouts ──────────────────────────────────────────────
# Seconds to wait for the first checkpoint load, which includes the download.
ENGINE_START_TIMEOUT=900
# Seconds to wait for PostgreSQL to report healthy.
# INFRA_START_TIMEOUT=60

# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  4 · USE CASES                                                             ║
# ║  Domain configuration. Read only by the use case that owns it.             ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── playwright-decisions · target under test ──────────────────────────────────
# These three are force-loaded from this file even when the shell exports them.
# The default target is Sauce Demo, a public site built for automation practice;
# its test accounts are published on its own login page. Replace all three with
# your application's URL and a dedicated test account to collect real evidence.
# Leave the credentials empty to run only the anonymous login-flow suite.
BASE_URL=https://www.saucedemo.com/
SITE_USERNAME=standard_user
SITE_PASSWORD=secret_sauce

# ── playwright-decisions · run metadata ───────────────────────────────────────
# Persisted with every actual Playwright run.
APP_NAME=demo-app
PROJECT_ID=system-one-decision-lab
PROJECT_CONFIGURATION=chromium-smoke
SQUAD_NAME=local
BRANCH_NAME=local
COMMIT_SHA=

# ── playwright-decisions · run behaviour ──────────────────────────────────────
# Everything else a run does is fixed: every project (including `setup`) is
# persisted, and the report is rebuilt with a file:// link at the end.
# Booleans accept true/1/yes/on/enabled and false/0/no/off/disabled; anything
# else is warned about rather than silently treated as off.

# true   ask the selected engine about every failure. Triage is then REQUIRED:
#        an engine that is down, misconfigured, or refused fails the run (the
#        evidence is still persisted) and the cause is printed.
# false  persist failures without asking an engine.
DECISION_TRIAGE_ENABLED=false

# true   fail the run when its evidence cannot be persisted to PostgreSQL.
# false  keep the tests' own verdict; the failure is still printed and
#        recorded in the run manifest.
INGEST_REQUIRED=true

{
  "name": "system-one-decision-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A System One decision lab: shared decision infrastructure plus one package per use case",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/infra/*",
    "packages/providers/*",
    "packages/usecases/*"
  ],
  "scripts": {
    "infra": "yarn workspace @sysone/orchestrator",
    "lab": "yarn workspace @sysone/playwright-decisions",
    "bootstrap": "./start && yarn db:migrate",
    "create:usecase": "node tools/create-usecase.mjs",
    "clean": "yarn workspaces foreach -A --topological-dev run clean",
    "check": "yarn typecheck && yarn lint && yarn test",
    "typecheck": "yarn workspaces foreach -A --topological-dev run typecheck",
    "test": "node --test tools/*.test.mjs && yarn workspaces foreach -A --topological-dev run test",
    "lint": "eslint .",
    "db:migrate": "yarn workspaces foreach -A --topological-dev run db:migrate",
    "db:generate": "yarn workspaces foreach -A --topological-dev run db:generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "typescript-eslint": "8.70.1"
  },
  "resolutions": {
    "esbuild": "0.28.2"
  },
  "packageManager": "yarn@4.12.0"
}
